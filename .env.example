# Nunca versionar .env real. R3 executa SOMENTE DEMO.
NEXVORY_ALLOW_DEMO_EXECUTION=false
NEXVORY_DERIV_API_BASE=https://api.derivws.com
NEXVORY_DERIV_PUBLIC_WS=wss://api.derivws.com/trading/v1/options/ws/public
NEXVORY_DATABASE_URL=postgresql+psycopg://nexvory:CHANGE_ME@postgres:5432/nexvory
NEXVORY_REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=CHANGE_ME
# Credenciais devem existir somente no servidor, nunca no APK.
DERIV_BEARER_TOKEN=
DERIV_APP_ID=
DERIV_DEMO_ACCOUNT_ID=
DERIV_CURRENCY=USD
